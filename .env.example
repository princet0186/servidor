# Groq: primary reasoning engine (console.groq.com). Add GROQ_API_KEY_1..5 to rotate keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Gemini: fallback engine (AI Studio keys; keys from different Google projects add rate-limit headroom)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3-flash-preview
ADK_MODEL=gemini-2.5-flash
# Or use Vertex AI through the Cloud Run service account instead of keys
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=global

# MongoDB Atlas (optional; falls back to JSON files)
MONGODB_URI=
MONGODB_DB=servidor

# Real email alerts (Gmail: smtp.gmail.com, port 587, an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Frontend origin allowed by CORS in production
FRONTEND_URL=

# Optional: Dynatrace
DYNATRACE_URL=
DYNATRACE_TOKEN=
